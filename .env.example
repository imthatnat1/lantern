# Copy to .env on the server. Never commit .env.
HELIUS_API_KEY=
RUGCHECK_API_KEY=
# Optional. Leave blank to disable social scoring.
X_BEARER_TOKEN=
# Optional LLM for lore scoring. Leave blank to skip lore.
ANTHROPIC_API_KEY=
# Comma-separated Solana wallet addresses Nat trusts.
TRUSTED_WALLETS=
# Starting paper capital in USD.
STARTING_CAPITAL=300
# info | debug
LOG_LEVEL=info
DB_PATH=./data/lantern.db

# Dashboard API (read-only). Pick a long random string. Same value goes in the Vercel project env.
DASHBOARD_TOKEN=
DASHBOARD_PORT=8787
